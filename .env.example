# Marrow keeps your library in this folder. Change DATA_DIR to move it elsewhere.
# Default: ./data  (SQLite database, files/ for PDFs, whisper/ for downloads)
# DATA_DIR=/path/to/your/marrow-data
# Encrypts your AI keys in the database. 64 hex characters. Keep a backup: lose it and you must re-enter your keys.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Optional: public domain name(s) this server is reached by (comma-separated), and who may connect (default: this machine only)
# ALLOWED_HOSTS=marrow.example.com
# HOST=0.0.0.0
# Optional: port (default 5173), and comma-separated free models tried in order (VISION_MODELS for images)
# PORT=5173
# MODELS=
# VISION_MODELS=
