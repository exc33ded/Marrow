# Supabase: Project Settings > API. The publishable key is safe to use here; never put the secret/service_role key in this app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Encrypts every reader's AI key in the database. 64 hex characters. Keep a backup: lose it and readers must re-enter their keys.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Optional: public domain name(s) this server is reached by (comma-separated), and who may connect (default: this machine only)
# ALLOWED_HOSTS=marrow.example.com
# HOST=0.0.0.0
# Optional: comma-separated free models, tried in order (VISION_MODELS for images)
# MODELS=
# Tests only (.env.test): two throwaway users made in Supabase > Authentication > Users
# TEST_EMAIL_A=  TEST_EMAIL_B=  TEST_PASSWORD=
